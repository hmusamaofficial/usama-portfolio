# Server only. Never prefix credentials with NEXT_PUBLIC_.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Redis REST service (e.g. Upstash). Required in production; fails closed if absent.
CONTACT_REDIS_URL=
CONTACT_REDIS_TOKEN=
# Generate a random secret of at least 32 bytes. Used to hash rate-limit identifiers.
CONTACT_RATE_SECRET=
# Exact comma-separated preview origins. Canonical production origin is always allowed.
CONTACT_ALLOWED_ORIGINS=
# Optional; omit until verified with Search Console.
GOOGLE_SITE_VERIFICATION=
